{"tipo": {"id": 337, "nombre": "Compliance: Accept a supplier's declining of a compliance grid", "fileName": "ComplianceAcceptDeclinedGrid_ES.html", "subject": "The grid you declined has been accepted by %CompanyName%", "buildType": 0, "inactivo": false}, "idiomaSugerido": 1, "lang": 1, "archivo": {"estado": "leido", "codificacion": "utf-8-bom", "bytes": 4212}, "formato": "completo", "cuerpo": "<td class=\"notificacion-cuerpo\">\n<table align=\"center\" style=\"font-family:sans-serif; max-width:600px; padding:10px; border-collapse: collapse;\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"background-color:#111519; border-bottom: solid 4px #005394\"><a href=\"http://www.azzule.com\"><img alt=\"Logo\" src=\"http://www.azzule.com/images/logoAzzule.png\" style=\"margin:10px\" /></a></td>\r\n                <td style=\"background-color:#111519; border-bottom: solid 4px #005394; text-align: right;\"></td>\r\n            </tr>\r\n            <tr>\r\n                <td colspan=\"2\">\r\n                    <table style=\"width:90%; margin: 0 auto; font-size: 13px;\">\r\n                    <tbody>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>\r\n                                <p style=\"color:#3C83B9;\"><b>Dear</b> %ContactFirstName% %ContactLastName%,</p>\r\n                            </td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>This email is to inform you that %CompanyName% has accepted your decision to decline the following compliance grid:</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n\t\t\t\t\t\t<tr>\r\n                            <td>%ComplianceGridName% Grid</td>\r\n                        </tr>\r\n\t\t\t\t\t\t<tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td style=\"text-align:justify; line-height:1.5\">You may continue sending food safety information to your customer but you may have difficulty achieving compliance to their food safety program. This is because you will no longer be monitored in the automated compliance tracking that is built into the compliance grid.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>If you would like access to the compliance grid and return to their food safety program please contact %CompanyName% and request the grid to be sent to you.</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td>If you would like additional information or require assistance please contact us at <a href=\"mailto:support@azzule.com\">support@azzule.com</a>.</td>\r\n                        </tr>\r\n\t\t\t\t\t\t<tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n\t\t\t\t\t\t<tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                        <tr style=\"color:#3C83B9;\">\r\n                            <td>Regards,<br>Azzule Systems</td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td></td>\r\n                        </tr>\r\n                        <tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n\t\t\t\t\t\t<tr>\r\n                            <td><br></td>\r\n                        </tr>\r\n                    </tbody>\r\n                    </table>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td colspan=\"2\" style=\"background-color: #EDEDED; text-align: left; padding: 30px; border-top: solid 1px #3C83B9;\">\r\n                    <p style=\"color: #777777; font-size: 12px; text-align: left; margin:0\">If you have received this email in error and have not registered an account, please disregard.</p>\r\n                    <p style=\"color: #777777; font-size: 12px; text-align: left;\">Contact us at <a style=\"color:#3C83B9;\" href=\"mailto:support@azzule.com\">support@azzule.com</a> if you require additional assistance.</p>\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n        </table>\n</td>", "pie": null, "estilosHead": null, "parametros": [{"codigo": "ContactFirstName", "clase": "catalogo", "enCatalogo": true}, {"codigo": "ContactLastName", "clase": "catalogo", "enCatalogo": true}, {"codigo": "CompanyName", "clase": "catalogo", "enCatalogo": true}, {"codigo": "ComplianceGridName", "clase": "catalogo", "enCatalogo": true}], "avisos": [{"codigo": "encabezado_propio", "mensaje": "El cuerpo trae el encabezado propio del Legacy (celda oscura #111519; imagen de logo): quítalo para no duplicarlo con el encabezado compartido (ContentHeader_0).", "severidad": "revisar"}, {"codigo": "pie_propio", "mensaje": "El cuerpo trae el pie propio del Legacy (texto \"received this email in error\"; fondo #EDEDED): quítalo para no duplicarlo con el pie compartido (ContentBottom_0) y el disclaimer inferior.", "severidad": "revisar"}, {"codigo": "parametros", "mensaje": "El cuerpo usa 4 %X%: %ContactFirstName%, %ContactLastName%, %CompanyName%, %ComplianceGridName%. Pueden no coincidir con lo que mande el generador al tipo nuevo (p. ej. el Legacy usa %ContactFirstName% y el cuerpo de 2002 usa %SupplierName%).", "severidad": "info"}]}